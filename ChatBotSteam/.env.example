# Copy to .env and fill in your own credentials. Never commit real keys.
# DEEPSEEK_APIKEY is also accepted for compatibility.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Choose a model available in your provider account.
DEEPSEEK_MODEL_ID=deepseek-chat

# Only required when running telegram_bot.py.
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Intent extraction: deepseek (default) or wit.
NLU_ENGINE=deepseek
# Only required for NLU_ENGINE=wit. Use your app's Server Access Token.
# Wit.ai requires a configured/trained app. DeepSeek still generates responses.
WIT_AI_TOKEN=your_wit_server_access_token_here
